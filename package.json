{
  "name": "opentodo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n ui,api -c cyan,green \"vite\" \"node --env-file=.env --import tsx src/server/dev.ts\"",
    "build": "vite build",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "seed:colab": "node scripts/seed-colab.mjs",
    "board": "node skills/opentodo-board/scripts/board.mjs",
    "start:api": "node --env-file=.env --import tsx src/server/dev.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@hono/zod-openapi": "^0.18.0",
    "@libsql/client": "^0.15.0",
    "hono": "^4.6.0",
    "lucide-preact": "^0.575.0",
    "preact": "^10.25.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "@types/node": "^26.6.6",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
